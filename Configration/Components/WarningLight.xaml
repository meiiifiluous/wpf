<UserControl x:Class="Configration.Components.WarningLight"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Configration.Components"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="60">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:0.5"
                                     From="0"
                                     To="1"
                                     Storyboard.TargetName="borFault"
                                     Storyboard.TargetProperty="Opacity"
                                     RepeatBehavior="Forever"
                                     AutoReverse="True"/>
                    <DoubleAnimation Duration="0:0:0.5"
                                     From="0"
                                     To="1"
                                     Storyboard.TargetName="borWarning"
                                     Storyboard.TargetProperty="Opacity"
                                     RepeatBehavior="Forever"
                                     AutoReverse="True"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Viewbox>
        <StackPanel>
            <Border Width="40"
                    Height="10"
                    CornerRadius="7,7,0,0"
                    Background="#DDD"/>



            <Border Width="40"
                    Height="50"
                    Background="DarkRed"/>
            <Border Width="40"
                    Height="50"
                    Margin="0,-50,0,0"
                    Background="OrangeRed"
                    Visibility="Hidden"
                    Opacity="1"
                    Name="borFault">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Color="OrangeRed"
                                      Direction="0"
                                      ShadowDepth="0"/>
                </Border.Effect>
            </Border>

            <Border Width="40"
                    Height="50"
                    Background="DarkOrange"/>
            <Border Width="40"
                    Height="50"
                    Margin="0,-50,0,0"
                    Background="gold"
                    Visibility="Hidden"
                    Opacity="1"
                    Name="borWarning">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Color="gold"
                                      Direction="0"
                                      ShadowDepth="0"/>
                </Border.Effect>
            </Border>

            <Border Width="40"
                    Height="50"
                    Background="DarkGreen"/>
            <Border Width="40"
                    Height="50"
                    Margin="0,-50,0,0"
                    Background="LightGreen"
                    Visibility="Collapsed"
                    Name="borRun">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Color="LightGreen"
                                      Direction="0"
                                      ShadowDepth="0"/>
                </Border.Effect>
            </Border>



            <Border Width="40"
                    Height="10"
                    CornerRadius="0,0,7,7"
                    Background="#DDD"/>

            <Border Width="20"
                    Height="30"
                    CornerRadius="0,0,3,3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#999" Offset="0"/>
                        <GradientStop Color="#DDD" Offset="0.5"/>
                        <GradientStop Color="#999" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </StackPanel>
    </Viewbox>
</UserControl>
