<UserControl x:Class="Configration.Components.Feed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Configration.Components"
             mc:Ignorable="d" 
             d:DesignHeight="73"
             d:DesignWidth="50">
    <Grid>
        <Border VerticalAlignment="Top"
            Height="16"
            BorderThickness="0,10,0,3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#DDD" Offset="0"/>
                    <GradientStop Color="#FFF" Offset="0.3"/>
                    <GradientStop Color="#FFF" Offset="0.7"/>
                    <GradientStop Color="#DDD" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#999" Offset="0"/>
                    <GradientStop Color="#FFF" Offset="0.3"/>
                    <GradientStop Color="#FFF" Offset="0.7"/>
                    <GradientStop Color="#999" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
        <Border Height="30"
            VerticalAlignment="Top"
            Margin="0,16,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#DDD" Offset="0"/>
                    <GradientStop Color="#FFF" Offset="0.3"/>
                    <GradientStop Color="#FFF" Offset="0.7"/>
                    <GradientStop Color="#DDD" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Path Data="M0 0 50 0 25 30z"
          VerticalAlignment="Top"
          Margin="0,46,0,0">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#DDD" Offset="0"/>
                    <GradientStop Color="#FFF" Offset="0.3"/>
                    <GradientStop Color="#FFF" Offset="0.7"/>
                    <GradientStop Color="#DDD" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>
        <Border Height="6"
            Background="Orange"
            CornerRadius="3"
            VerticalAlignment="Bottom"
            Margin="8,0"/>
        <Border Width="14"
            Height="14"
            CornerRadius="7"
            Background="OrangeRed"
            VerticalAlignment="Top"
            Margin="0,15,0,0">
            <TextBlock Text="M"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="9"/>
        </Border>
    </Grid>
</UserControl>
