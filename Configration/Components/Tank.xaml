<UserControl x:Class="Configration.Components.Tank"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Configration.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:2"
                                     From="0"
                                     To="-118"
                                     Storyboard.TargetName="tt"
                                     Storyboard.TargetProperty="X"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <!--Viewbox:整体自动缩放-->
    <Viewbox>
        <Grid Width="124" Height="120">
            <!--液体层-->
            <Canvas Margin="3,0">
                <!--裁剪成罐体形状-->
                <Canvas.Clip>
                    <RectangleGeometry Rect="0 -20 118 140"
                                       RadiusX="20"
                                       RadiusY="20"/>
                </Canvas.Clip>
                <!--波浪形液体-->
                <Path Data="M0,0               A30 30 0 0 1 30,0               A30 30 0 0 0 60,0               A30 30 0 0 1 90,0               A30 30 0 0 0 120,0               A30 30 0 0 1 150,0               A30 30 0 0 0 180,0               A30 30 0 0 1 210,0               A30 30 0 0 0 240,0               L240 120               0 120z" Fill="#7BB7FD">
                    <!--移动液体-->
                    <Path.RenderTransform>
                        <TranslateTransform X="-90" Y="20" x:Name="tt"/>
                    </Path.RenderTransform>
                </Path>
            </Canvas>
            <!--罐口顶部橙色细线-->
            <Border Height="2"
                    Background="Orange"
                    VerticalAlignment="Top"/>
            <!--罐体外壳圆角玻璃-->
            <Border Width="120"
                    Height="118"
                    BorderThickness="1,0,1,1"
                    BorderBrush="#888"
                    VerticalAlignment="Bottom"
                    CornerRadius="0,0,20,20">
                <!--玻璃透明度-->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#DDD" Offset="0"/>
                        <GradientStop Color="#1DDD" Offset="0.3"/>
                        <GradientStop Color="#1DDD" Offset="0.7"/>
                        <GradientStop Color="#DDD" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
