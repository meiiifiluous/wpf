<UserControl x:Class="Configration.Components.Valve"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Configration.Components"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="40">
    <Viewbox>
        <Grid Width="40" Height="40">
            <Border Height="10"
                BorderThickness="2,0"
                BorderBrush="Gray">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#DDD" Offset="0"/>
                        <GradientStop Color="White" Offset="0.5"/>
                        <GradientStop Color="#DDD" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Width="20"
                Height="20"
                CornerRadius="10">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#DDD" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border Width="8"
                Height="8"
                CornerRadius="4"
                Background="Orange"/>
            <Border Height="4"
                Width="20"
                Background="Orange"
                HorizontalAlignment="Right"
                CornerRadius="0,10,10,0">
                <Border.RenderTransform>
                    <RotateTransform Angle="90" CenterY="2" x:Name="rt"/>
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
